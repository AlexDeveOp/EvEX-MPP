{
  "name": "evex-mpp",
  "version": "0.10.0",
  "description": "Cliente XMPP de escritorio moderno y personalizable para comunidades de EVE Online",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node scripts/start.mjs --dev",
    "assets": "node scripts/build-assets.mjs",
    "probe": "node scripts/probe.mjs",
    "build:icon": "node scripts/build-icon.mjs",
    "dist": "node scripts/build-icon.mjs && electron-builder --win nsis portable --publish never && node scripts/check-build-clean.mjs",
    "dist:dir": "electron-builder --win dir --publish never",
    "dist:linux": "node scripts/build-icon.mjs && electron-builder --linux AppImage deb --publish never && node scripts/check-build-clean.mjs",
    "dist:store": "node scripts/build-icon.mjs && node scripts/build-store-assets.mjs && electron-builder --win appx --x64 --publish never && node scripts/check-build-clean.mjs",
    "mock": "node test/mock-xmpp.mjs",
    "demo": "node scripts/demo.mjs",
    "i18n": "node scripts/i18n-check.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --import ./test/unit/setup.mjs --test --test-timeout=120000 \"test/unit/*.test.mjs\" \"test/unit/*.test.js\"",
    "coverage": "node --import ./test/unit/setup.mjs --test --experimental-test-coverage --test-coverage-include=\"src/**\" \"test/unit/*.test.mjs\" \"test/unit/*.test.js\"",
    "lint": "eslint .",
    "assets:emoji": "node scripts/build-anim-emoji.mjs",
    "assets:flags": "node scripts/build-flag-emoji.mjs",
    "license-pages": "node scripts/build-license-pages.mjs"
  },
  "author": "AlexDeveOp",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/orbitron": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@xmpp/client": "^0.14.0",
    "ltx": "^3.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "emojibase-data": "^18.0.0",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "lucide-static": "^1.66.0",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.4"
  },
  "productName": "EvEX-MPP",
  "desktopName": "evex-mpp.desktop",
  "build": {
    "appId": "com.evex.mpp",
    "productName": "EvEX-MPP",
    "copyright": "Copyright © 2026 AlexDeveOp",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/@fontsource-variable/*/files/*-{opsz,standard}-*",
      "!node_modules/@fontsource-variable/*/files/*-italic.woff2",
      "!node_modules/@fontsource/rajdhani/files/*.woff",
      "!node_modules/@fontsource/rajdhani/{files/*-300-*,300.css}",
      "!node_modules/@xmpp/client/{dist,example.js,test.js}"
    ],
    "electronLanguages": [
      "es",
      "es-419",
      "en-US",
      "en-GB"
    ],
    "compression": "maximum",
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "EvEX-MPP"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "EvEX-MPP",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerLanguages": [
        "es_ES",
        "en_US"
      ],
      "language": "3082",
      "artifactName": "EvEX-MPP-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "EvEX-MPP-${version}-portable.${ext}"
    },
    "appx": {
      "identityName": "AlexDeveOp.EvEX-MPP",
      "publisher": "CN=D99A5CBF-A751-459F-A336-A7E18F6CBF37",
      "applicationId": "EvEXMPP",
      "displayName": "EvEX-MPP",
      "publisherDisplayName": "AlexDeveOp",
      "languages": [
        "es-ES",
        "en-US"
      ],
      "backgroundColor": "transparent",
      "minVersion": "10.0.19041.0",
      "maxVersionTested": "10.0.26100.0",
      "customManifestPath": "appx-manifest.xml",
      "customExtensionsPath": "build/appx-extensions.xml",
      "artifactName": "EvEX-MPP-${version}-store.${ext}"
    },
    "linux": {
      "compression": "normal",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "executableName": "evex-mpp",
      "category": "Network;InstantMessaging;Chat;",
      "synopsis": "Desktop XMPP (Jabber) client for EVE Online communities",
      "description": "XMPP (Jabber) client for EVE Online communities: fleet pings as cards, pop-up alerts, EVE time and themes. English and Spanish.",
      "maintainer": "AlexDeveOp <351246578+AlexDeveOp@users.noreply.github.com>",
      "vendor": "AlexDeveOp",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "GenericName": "XMPP Client",
          "Keywords": "xmpp;jabber;chat;eve;fleet;ping;"
        }
      }
    },
    "appImage": {
      "artifactName": "EvEX-MPP-${version}-x86_64.${ext}"
    },
    "deb": {
      "compression": "xz",
      "artifactName": "evex-mpp_${version}_amd64.${ext}",
      "recommends": [
        "gnome-keyring | kwalletmanager",
        "speech-dispatcher"
      ]
    },
    "publish": null,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeCliInspectArguments": false,
      "enableNodeOptionsEnvironmentVariable": false
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexDeveOp/EvEX-MPP.git"
  }
}
